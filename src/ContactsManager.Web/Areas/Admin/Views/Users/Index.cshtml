@model IReadOnlyCollection<AdminUserViewModel>

@{
    ViewBag.Title = "Admin Users";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div>
        <h1 class="h2 mb-1"><i class="bi bi-shield-lock me-2 text-primary"></i>Admin Area</h1>
        <p class="text-muted mb-0">Manage which users can access administrative pages.</p>
    </div>
</div>

@if (TempData["ResultErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Error:</strong> @TempData["ResultErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">User</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No users found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-medium">
                                <i class="bi bi-person-circle text-secondary me-2"></i>@user.UserName
                            </td>
                            <td><a href="mailto:@user.Email" class="text-decoration-none">@user.Email</a></td>
                            <td>
                                @if(user.Roles.Count == 0)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle">No roles</span>
                                }
                                else
                                {
                                    @foreach(var role in user.Roles)
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info-subtle me-1">@role</span>
                                    }
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (!user.IsAdmin)
                                {
                                    <form asp-action="PromoteToAdmin" method="post" class="d-inline m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-shield-plus me-1"></i> Make Admin</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="DemoteFromAdmin" method="post" class="d-inline m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-shield-minus me-1"></i> Remove Admin</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
