@model ContactsManager.Web.Models.ErrorViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error</title>
     <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/all.min.css">
    <link rel="icon" type="image/png" href="~/favicon.png">
</head>
<body>
    <div class="error-page">

    <div class="error-icon-wrap @Model.VariantClass">
        <i class="@Model.IconClass"></i>
    </div>

    <span class="error-code @Model.VariantClass">@Model.ErrorCode</span>

    <h1 class="error-title">@Model.Title</h1>
    <p class="error-message">@Model.Message</p>

    @if (!string.IsNullOrWhiteSpace(Model.Details))
    {
        <p class="error-message" style="margin-top:10px; opacity:.85; font-size:.95rem;">@Model.Details</p>
    }

    @if (!string.IsNullOrWhiteSpace(Model.TraceId))
    {
        <p class="error-message" style="margin-top:8px; opacity:.7; font-size:.9rem;">Trace: @Model.TraceId</p>
    }

    <div class="error-actions">
            <a href="/" class="btn btn-primary">
                <i class="fa-solid fa-house"></i> Go Home
            </a>
            <a href="javascript:history.back()" class="btn btn-outline">
                <i class="fa-solid fa-arrow-left"></i> Go Back
            </a>
    </div>

</div>

</body>
</html>



