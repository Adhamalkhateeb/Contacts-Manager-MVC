@model PersonResponse

@{
    ViewBag.Title = "Delete Person";
    ViewBag.CurrentUrl = "~/Persons/Delete";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 mt-4 border-top border-danger border-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <i class="bi bi-exclamation-octagon text-danger" style="font-size: 3rem;"></i>
                    <h2 class="fw-bold mt-2">Delete Person</h2>
                    <p class="text-muted">Are you sure you want to delete this contact?</p>
                </div>

                <div class="card bg-light border-0 mb-4">
                    <div class="card-body">
                        <h4 class="card-title fw-bold">@Model.Name</h4>
                        <ul class="list-unstyled mb-0 mt-3 text-muted">
                            <li class="mb-2"><i class="bi bi-envelope me-2 text-secondary"></i> <strong>Email:</strong> @Model.Email</li>
                            <li class="mb-2"><i class="bi bi-calendar-event me-2 text-secondary"></i> <strong>Age:</strong> @Model.Age yrs</li>
                            <li class="mb-2"><i class="bi bi-gender-ambiguous me-2 text-secondary"></i> <strong>Gender:</strong> @Model.Gender</li>
                            <li><i class="bi bi-geo-alt me-2 text-secondary"></i> <strong>Country:</strong> @Model.Country</li>
                        </ul>
                    </div>
                </div>

                <div class="alert alert-danger mb-4 d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                    <div>
                        <strong>Warning:</strong> All data associated with this person will be permanently removed from the system. This cannot be undone.
                    </div>
                </div>

                <form asp-controller="Persons" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="form-check mb-4 p-3 bg-light rounded-3 border">
                        <input class="form-check-input ms-2 mt-2" type="checkbox" id="confirmCheck" required>
                        <label class="form-check-label fw-medium ms-2 mt-1" for="confirmCheck">
                            I understand this cannot be undone
                        </label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger flex-grow-1" id="deleteBtn" disabled>
                            <i class="bi bi-trash me-1"></i> Delete Contact
                        </button>
                        <a asp-controller="Persons" asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('confirmCheck').addEventListener('change', function() {
        document.getElementById('deleteBtn').disabled = !this.checked;
    });
</script>