@model CreatePersonRequest

@{
    ViewBag.Title = "Create Person";
    ViewBag.CurrentUrl = "~/Persons/Create";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Add Person</h4>
            </div>
            <div class="card-body p-4 p-md-5">
                <p class="text-muted mb-4">Fill in the details below to create a new contact.</p>

                <form asp-controller="Persons" asp-action="Create" method="post">
                    
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Basic Information</h5>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Jane Smith" autofocus required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="jane@example.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold">Date of Birth</label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" value="@(Model?.DateOfBirth.HasValue == true ? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Gender <span class="text-danger">*</span></label>
                            <div class="mt-2">
                                @foreach (var gender in Enum.GetNames<Gender>())
                                {
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" asp-for="Gender" value="@gender" id="gender_@gender" required />
                                        <label class="form-check-label" for="gender_@gender">@gender</label>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 border-bottom pb-2 mt-4">Location & Preferences</h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CountryId" class="form-label fw-semibold">Country <span class="text-danger">*</span></label>
                            <select asp-for="CountryId" class="form-select" asp-items="@ViewBag.Countries" required>
                                <option value="">Select country…</option>
                            </select>
                            <span asp-validation-for="CountryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Address" class="form-label fw-semibold">Address</label>
                            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Street, city, postal code…"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check mt-2">
                                <input asp-for="ReceiveNewsLetters" class="form-check-input" type="checkbox" id="newsletterCheck" />
                                <label class="form-check-label" for="newsletterCheck">
                                    Receive newsletter updates
                                </label>
                            </div>
                            <span asp-validation-for="ReceiveNewsLetters" class="text-danger small"></span>
                        </div>
                    </div>

                    @if (ViewBag.Errors != null)
                    {
                        <div class="alert alert-danger mb-4">
                            <strong>Please fix the following:</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (string error in ViewBag.Errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="d-flex gap-2 mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save Person</button>
                        <a asp-controller="Persons" asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}