@model LoginRequest 
@{
    ViewBag.Title = "Login";
    ViewBag.CurrentUrl = "~/Account/Login";
}

<main>
    <div class="login-card">

        <div class="login-header">
            <div class="login-icon-wrap">
                <i class="fa-solid fa-user"></i>
            </div>
            <h2>Login to your account</h2>
            <p>Enter your credentials to access your account</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <i class="fa-solid fa-circle-exclamation"></i>
                <div>
                    <asp-validation-summary asp-validation-type="All" />
                </div>
            </div>
        }

        <form asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()


            <div class="form-group">
                <label asp-for="Email" class="form-label">
                    Email address <span class="required">*</span>
                </label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-solid fa-envelope"></i></span>
                    <input asp-for="Email"
                           class="input has-action"
                           placeholder="john@example.com"
                           autocomplete="email"
                           inputmode="email" />
                </div>
                <span asp-validation-for="Email" class="validation-error"></span>
            </div>

        

           
            <div class="form-group">
                <label asp-for="Password" class="form-label">
                    Password <span class="required">*</span>
                </label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-solid fa-lock"></i></span>
                    <input asp-for="Password"
                           id="password-input"
                           type="password"
                           class="input has-action"
                           placeholder="Enter your password"
                           autocomplete="current-password" />
                    <button type="button"
                            class="input-action"
                            onclick="togglePwd('password-input','eye-pw')"
                            tabindex="-1">
                        <i id="eye-pw" class="fa-solid fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="validation-error"></span>
            </div>
            <div class="form-group remember-me">
                <input asp-for="RememberMe" type="checkbox" id="remember-me" />
                <label for="remember-me">Remember Me</label>
            </div>


            <div class="login-submit">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-user-plus"></i>
                    Login
                </button>
                <p class="login-footer-text">
                    don't have an account?
                    <a asp-action="Register">Register</a>
                </p>
            </div>

         </form>
    </div>
</main>

@section scripts {
    @{ @Html.RenderPartialAsync("_ValidationScriptsPartial") }
    <script>
        function togglePwd(inputId, iconId) {
            const inp = document.getElementById(inputId);
            const ico = document.getElementById(iconId);
            const show = inp.type === 'password';
            inp.type = show ? 'text' : 'password';
            ico.className = show ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
        }
    </script>
}