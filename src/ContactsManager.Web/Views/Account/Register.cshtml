@model RegisterRequest
@{
    ViewBag.Title = "Register";
    ViewBag.CurrentUrl = "~/Account/Register";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4 p-md-5">
                <h2 class="fw-bold text-center mb-3">Create your account</h2>
                <p class="text-muted text-center mb-4">Fill in your details to get started</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="Register" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="UserName" class="form-label fw-semibold">Username <span class="text-danger">*</span></label>
                            <input asp-for="UserName" class="form-control" placeholder="john_doe" autocomplete="username" required />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone number <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control" type="tel" placeholder="+20 100 000 0000" autocomplete="tel" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email address <span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="john@example.com" autocomplete="email" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Min. 8 characters" autocomplete="new-password" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm password <span class="text-danger">*</span></label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Repeat your password" autocomplete="new-password" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">Create account</button>
                    </div>

                    <p class="text-center text-muted mt-4 mb-0">
                        Already have an account? <a asp-action="Login" class="text-decoration-none">Sign in</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
