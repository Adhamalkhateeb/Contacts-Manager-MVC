@model RegisterRequest
@{
    ViewBag.Title = "Register";
    ViewBag.CurrentUrl = "~/Account/Register";
}
<main>
    <div class="register-card">

        <div class="register-header">
            <div class="register-icon-wrap">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <h2>Create your account</h2>
            <p>Fill in your details to get started</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <i class="fa-solid fa-circle-exclamation"></i>
                <div>
                   <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            </div>
        }

        <form asp-action="Register" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="UserName" class="form-label">
                    Username <span class="required">*</span>
                </label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-solid fa-at"></i></span>
                    <input asp-for="UserName"
                           class="input has-action"
                           placeholder="john_doe"
                           autocomplete="username"
                           spellcheck="false" />
                </div>
                <span asp-validation-for="UserName" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">
                    Email address <span class="required">*</span>
                </label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-solid fa-envelope"></i></span>
                    <input asp-for="Email"
                           class="input has-action"
                           placeholder="john@example.com"
                           autocomplete="email"
                           inputmode="email" />
                </div>
                <span asp-validation-for="Email" class="validation-error"></span>
            </div>

         
            <div class="form-group">
                <label asp-for="PhoneNumber" class="form-label">
                    Phone number <span class="required">*</span>
                </label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-solid fa-phone"></i></span>
                    <input asp-for="PhoneNumber"
                           class="input has-action"
                           placeholder="+20 100 000 0000"
                           autocomplete="tel"
                           inputmode="tel" />
                </div>
                <span asp-validation-for="PhoneNumber" class="validation-error"></span>
            </div>

           
            <div class="form-group">
                <label asp-for="Password" class="form-label">
                    Password <span class="required">*</span>
                </label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-solid fa-lock"></i></span>
                    <input asp-for="Password"
                           id="password-input"
                           type="password"
                           class="input has-action"
                           placeholder="Min. 8 characters"
                           autocomplete="new-password" />
                    <button type="button"
                            class="input-action"
                            onclick="togglePwd('password-input','eye-pw')"
                            tabindex="-1">
                        <i id="eye-pw" class="fa-solid fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="validation-error"></span>
                <div class="strength-bar-wrap" id="strength-bar-wrap">
                    <div class="strength-bar-track">
                        <div class="strength-bar-fill" id="strength-bar"></div>
                    </div>
                    <span class="strength-label" id="strength-label"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label">
                    Confirm password <span class="required">*</span>
                </label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-solid fa-lock-open"></i></span>
                    <input asp-for="ConfirmPassword"
                           id="confirm-input"
                           type="password"
                           class="input has-action"
                           placeholder="Repeat your password"
                           autocomplete="new-password" />
                    <button type="button"
                            class="input-action"
                            onclick="togglePwd('confirm-input','eye-cf')"
                            tabindex="-1">
                        <i id="eye-cf" class="fa-solid fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="validation-error"></span>
                <span class="match-hint" id="match-hint"></span>
            </div>


            <div class="register-submit">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-user-plus"></i>
                    Create account
                </button>
                <p class="register-footer-text">
                    Already have an account?
                    <a asp-action="Login">Sign in</a>
                </p>
            </div>

        </form>
    </div>
</main>

@section scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>

             $(function () {
            const form = $('form');

            // re-configure the already-initialized validator instance
            form.validate().settings.onkeyup = false;

            // remote fires only on blur
            $('#UserName, #Email').on('blur', function () {
                form.validate().element(this);
            });
        });
        function togglePwd(inputId, iconId) {
            const inp = document.getElementById(inputId);
            const ico = document.getElementById(iconId);
            const show = inp.type === 'password';
            inp.type = show ? 'text' : 'password';
            ico.className = show ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
        }

        const pwInp = document.getElementById('password-input');
        const bar   = document.getElementById('strength-bar');
        const lbl   = document.getElementById('strength-label');
        const wrap  = document.getElementById('strength-bar-wrap');

        pwInp.addEventListener('input', function () {
            const v = this.value;
            wrap.style.display = v ? 'block' : 'none';

            const rules = [
                { test: v => v.length >= 8, message: 'at least 8 characters' },
                { test: v => /[A-Z]/.test(v), message: 'capital letters' },
                { test: v => /[0-9]/.test(v), message: 'numbers' },
                { test: v => /[^A-Za-z0-9]/.test(v), message: 'special characters' }
            ];

            let score = 0;
            let errors = [];

            rules.forEach(rule => {
                if (rule.test(v)) score++;
                else errors.push(rule.message);
            });

            let text = errors.length ? 'Password must contain: ' + errors.join(', ') : '';

            const levels = [
                { w: '25%',  bg: '#e53e3e' },
                { w: '50%',  bg: '#d69e2e' },
                { w: '75%',  bg: '#4f6ef7' },
                { w: '100%', bg: '#38a169' },
            ];
            const l = levels[Math.max(score - 1, 0)];
            bar.style.width      = v ? l.w  : '0';
            bar.style.background = v ? l.bg : '';
            lbl.textContent = text;
            lbl.style.color      = v ? l.bg  : 'var(--ink-3)';
            checkMatch();
        });

        const cfInp = document.getElementById('confirm-input');
        const hint  = document.getElementById('match-hint');

        function checkMatch() {
            if (!cfInp.value) { hint.style.display = 'none'; return; }
            const match = pwInp.value === cfInp.value;
            hint.style.display = 'block';
            hint.textContent   = match ? '✓ Passwords match' : '✗ Passwords do not match';
            hint.style.color   = match ? 'var(--success)' : 'var(--danger)';
        }

        cfInp.addEventListener('input', checkMatch);
    </script>
}
