@model PersonUpdateRequest

@{
    ViewBag.Title = "Edit Person";
    ViewBag.CurrentUrl = "~/Persons/Edit";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Person</h1>
        <p class="page-meta">Updating details for <strong>@Model.Name</strong></p>
    </div>
    <div class="page-actions">
        <a asp-controller="Persons" asp-action="Index" class="btn btn-outline">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
    </div>
</div>

<form asp-controller="Persons" asp-action="Edit" method="post" id="editForm">
    <input type="hidden" asp-for="Id" />

    <div class="form-section">
        <p class="section-heading">Basic Information</p>

        <div class="form-grid-2">
            <div class="form-group col-span-2">
                <label asp-for="Name" class="form-label">
                    Full Name <span class="required">*</span>
                </label>
                <input asp-for="Name" class="input" placeholder="Full name" autofocus required />
                <span asp-validation-for="Name" class="validation-error"></span>
            </div>

            <div class="form-group col-span-2">
                <label asp-for="Email" class="form-label">
                    Email Address <span class="required">*</span>
                </label>
                <input asp-for="Email" class="input" type="email" placeholder="email@example.com" required />
                <span asp-validation-for="Email" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                <input asp-for="DateOfBirth"
                       class="input"
                       type="date"
                       value="@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")" />
                <span asp-validation-for="DateOfBirth" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Gender <span class="required">*</span></label>
                <div class="gender-group">
                    @{
                        var genders = Enum.GetNames<Gender>();
                    }
                    @foreach (string gender in genders)
                    {
                        <label class="gender-card">
                            <input type="radio" asp-for="Gender" value="@gender" required />
                            <span class="gender-label">
                                <i class="fa-solid @(gender == "Male" ? "fa-mars" : gender == "Female" ? "fa-venus" : "fa-genderless")"></i>
                                @gender
                            </span>
                        </label>
                    }
                </div>
                <span asp-validation-for="Gender" class="validation-error"></span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <p class="section-heading">Location</p>

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="CountryId" class="form-label">Country</label>
                <select asp-for="CountryId" class="input" asp-items="@ViewBag.Countries">
                    <option value="">Select country…</option>
                </select>
                <span asp-validation-for="CountryId" class="validation-error"></span>
            </div>

            <div class="form-group col-span-2">
                <label asp-for="Address" class="form-label">Address</label>
                <textarea asp-for="Address" class="input" placeholder="Street, city, postal code…"></textarea>
                <span asp-validation-for="Address" class="validation-error"></span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <p class="section-heading">Preferences</p>

        <div class="toggle-row">
            <label class="toggle-wrap">
                <input asp-for="ReceiveNewsLetters" type="checkbox" />
                <span class="toggle-track"></span>
            </label>
            <span class="toggle-text">Receive newsletter updates</span>
        </div>
    </div>

    <div asp-validation-summary="All" class="validation-summary"></div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Save Changes
        </button>
        <a asp-controller="Persons" asp-action="Index" class="btn btn-outline">Cancel</a>
    </div>
</form>

@section scripts
 {
 <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js" asp-fallback-test="window.jQuery" asp-fallback-src="~/jquery.min.js"></script>

 <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.4/jquery.validate.min.js" asp-fallback-test="window.jQuery.validator" asp-fallback-src="~/jquery.validate.min.js"></script>

 <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js" asp-fallback-test="window.jQuery.validator.unobstrusive" asp-fallback-src="~/jquery.validate.unobtrusive.min.js"></script>
}