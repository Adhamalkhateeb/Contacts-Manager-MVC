@model PersonResponse

@{
    ViewBag.Title = "Delete Person";
}

<a asp-controller="Persons" asp-action="Index" class="link-hover mb">Back to Persons List</a>
<h2>Delete Person</h2>
<h3>Are you sure you want to delete that person?</h3>

<div class="center-box">
    <form asp-controller="Persons" asp-action="Delete" method="post">

        @* Id *@
        <input type="hidden" asp-for="Id">
            @*Name*@
            <div class="form-field flex">
                <div class="w-25">
                    <label asp-for="Name" class="form-label pt">Name</label>
                </div>
                <div class="flex-1">
                    <input asp-for="Name" class="form-input" disabled />
                    <span asp-validation-for="Name" class="text-red"></span>
                </div>
            </div>

            <div class="form-field flex">
                <div class="w-25">
                    <label asp-for="Email" class="form-label pt">Email</label>
                </div>
                <div class="flex-1">
                    <input asp-for="Email" class="form-input" disabled="disabled" />
                    <span asp-validation-for="Email" class="text-red"></span>
                </div>
            </div>


            @*Submit*@
            <div class="form-field flex">
                <div class="w-25">
                </div>
                <div class="flex-1">
                    <button class="button button-red-back">Delete</button>
                </div>
            </div>

        </form>
    </div>