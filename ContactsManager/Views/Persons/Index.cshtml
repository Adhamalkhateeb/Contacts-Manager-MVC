@model PersonsListViewModel
@{
    ViewBag.Title = "Persons";
    ViewBag.CurrentUrl = "~/Persons/Index";
}

@{
    string BuildOrderLink(string orderBy)
    {
        var sortOrder = Model.OrderBy == orderBy && Model.SortOrder == "ASC"
            ? "DESC"
            : "ASC";

        return $"/persons/index?searchBy={Model.SearchBy}&searchValue={Uri.EscapeDataString(Model.SearchValue ?? "")}&orderBy={orderBy}&sortOrder={sortOrder}";
    }

    string GetSortIcon(string columnName)
    {
        if (Model.OrderBy == columnName)
            return Model.SortOrder == "ASC" ? "fa-solid fa-arrow-up" : "fa-solid fa-arrow-down";
        return "fa-solid fa-arrows-up-down";
    }

    var isGenderSearch = Model.SearchBy == nameof(PersonResponse.Gender);
    var isDateSearch   = Model.SearchBy == nameof(PersonResponse.DateOfBirth);

    string? dateInputValue = null;
    if (isDateSearch && !string.IsNullOrEmpty(Model.SearchValue))
    {
        if (DateTime.TryParse(Model.SearchValue, out var parsedDate))
            dateInputValue = parsedDate.ToString("yyyy-MM-dd");
        else
            dateInputValue = Model.SearchValue;
    }
}

<form asp-controller="Persons" asp-action="@nameof(PersonsController.Index)" method="get" id="searchForm">


    <div class="page-header">
        <div>
            <h1 class="page-title">Persons</h1>
            <p class="page-meta">@Model.Persons.Count() contact@(Model.Persons.Count() == 1 ? "" : "s")</p>
        </div>
        <div class="page-actions">
            <a asp-controller="Persons" asp-action="@nameof(PersonsController.PersonsPDF)"
               class="btn btn-outline" title="Export PDF">
                <i class="fa-solid fa-file-pdf"></i> <span class="btn-label">PDF</span>
            </a>
            <a asp-controller="Persons" asp-action="@nameof(PersonsController.DownloadPersonsCsv)"
               class="btn btn-outline" title="Export CSV">
                <i class="fa-solid fa-file-csv"></i> <span class="btn-label">CSV</span>
            </a>
            <a asp-controller="Persons" asp-action="@nameof(PersonsController.DownloadPersonsExcel)"
               class="btn btn-outline" title="Export Excel">
                <i class="fa-solid fa-file-excel"></i> <span class="btn-label">Excel</span>
            </a>
            <a asp-controller="Persons" asp-action="@nameof(PersonsController.Create)" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Add Person
            </a>
        </div>
    </div>

    <!-- Search Panel -->
    <div class="search-panel">
        <div class="search-row">
            <div class="field-group">
                <label class="field-label" for="searchBy">Filter by</label>
                <select class="input" id="searchBy" name="searchBy">
                    @foreach (var field in Model.SearchFields)
                    {
                        @if (Model.SearchBy == field.Key)
                        {
                            <option value="@field.Key" selected>@field.Value</option>
                        }
                        else
                        {
                            <option value="@field.Key">@field.Value</option>
                        }
                    }
                </select>
            </div>

            <div class="field-group">
                <label class="field-label">Search</label>

                @* Text input: shown for most fields *@
                <input type="search" id="searchValueText"
                       class="input search-ctrl @(isGenderSearch || isDateSearch ? "sv-hidden" : "")"
                       placeholder="Type to search…"
                       autocomplete="off"
                       value="@(!isGenderSearch && !isDateSearch ? Model.SearchValue : null)">

                @* Gender dropdown *@
                <select id="searchValueGender"
                        class="input search-ctrl @(isGenderSearch ? "" : "sv-hidden")">
                    <option value="">All genders</option>
                    @if (Model.SearchValue == "Male")
                    {
                        <option value="Male" selected>Male</option>
                    }
                    else
                    {
                        <option value="Male">Male</option>
                    }
                    @if (Model.SearchValue == "Female")
                    {
                        <option value="Female" selected>Female</option>
                    }
                    else
                    {
                        <option value="Female">Female</option>
                    }
                    @if (Model.SearchValue == "Other")
                    {
                        <option value="Other" selected>Other</option>
                    }
                    else
                    {
                        <option value="Other">Other</option>
                    }
                </select>

                @* Date picker *@
                <input type="date" id="searchValueDate"
                       class="input search-ctrl @(isDateSearch ? "" : "sv-hidden")"
                       value="@dateInputValue">

                <input type="hidden" id="searchValueHidden" name="searchValue"
                       value="@Model.SearchValue">
            </div>

            <div class="search-btns">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-magnifying-glass"></i> Search
                </button>
                <a asp-action="@nameof(PersonsController.Index)" asp-controller="Persons" class="btn btn-outline">
                    Clear
                </a>
            </div>
        </div>
    </div>

    <!-- Table -->
    @if (Model.Persons.Any())
    {
        <div class="table-card">
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>
                                <a href="@BuildOrderLink(nameof(PersonResponse.Name))" class="sort-link">
                                    Name <i class="@GetSortIcon(nameof(PersonResponse.Name))"></i>
                                </a>
                            </th>
                            <th>
                                <a href="@BuildOrderLink(nameof(PersonResponse.Email))" class="sort-link">
                                    Email <i class="@GetSortIcon(nameof(PersonResponse.Email))"></i>
                                </a>
                            </th>
                            <th>
                                <a href="@BuildOrderLink(nameof(PersonResponse.DateOfBirth))" class="sort-link">
                                    Date of Birth <i class="@GetSortIcon(nameof(PersonResponse.DateOfBirth))"></i>
                                </a>
                            </th>
                            <th>
                                <a href="@BuildOrderLink(nameof(PersonResponse.Age))" class="sort-link">
                                    Age <i class="@GetSortIcon(nameof(PersonResponse.Age))"></i>
                                </a>
                            </th>
                            <th>
                                <a href="@BuildOrderLink(nameof(PersonResponse.Gender))" class="sort-link">
                                    Gender <i class="@GetSortIcon(nameof(PersonResponse.Gender))"></i>
                                </a>
                            </th>
                            <th>Country</th>
                            <th>Newsletter</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var person in Model.Persons)
                        {
                            <tr>
                                <td>
                                    <div class="person-name">
                                        <div class="avatar">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        @person.Name
                                    </div>
                                </td>
                                <td>
                                    <a href="mailto:@person.Email" class="email-link">@person.Email</a>
                                </td>
                                <td class="text-muted">
                                    @(person.DateOfBirth.HasValue ? person.DateOfBirth.Value.ToString("dd MMM yyyy") : "—")
                                </td>
                                <td>
                                    <span class="badge badge-neutral">@(person.Age == -0 ? 0 : person.Age ) </span>
                                </td>
                                <td>
                                    @{
                                        var genderClass = person.Gender switch {
                                            "Male"   => "badge-blue",
                                            "Female" => "badge-pink",
                                            _        => "badge-teal"
                                        };
                                    }
                                    <span class="badge @genderClass">@person.Gender</span>
                                </td>
                                <td class="text-muted">@person.Country</td>
                                <td>
                                    @if (person.ReceiveNewsLetters)
                                    {
                                        <span class="badge badge-green">
                                            <i class="fa-solid fa-check" style="font-size:.65rem"></i> Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-gray">No</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-cell">
                                        <a asp-controller="Persons" asp-action="Edit" asp-route-id="@person.Id"
                                           class="icon-btn icon-btn-edit" title="Edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <a asp-controller="Persons" asp-action="Delete" asp-route-id="@person.Id"
                                           class="icon-btn icon-btn-delete" title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="table-footer">
                <span>@Model.Persons.Count() result@(Model.Persons.Count() == 1 ? "" : "s")</span>
                @if (!string.IsNullOrEmpty(Model.SearchValue))
                {
                    <span>Filtered by "@Model.SearchValue"</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fa-solid fa-users"></i>
                </div>
                <h3>No persons found</h3>
                <p>Try adjusting your search, or add your first contact.</p>
                <div class="empty-actions">
                    <a asp-controller="Persons" asp-action="Create" class="btn btn-primary">
                        <i class="fa-solid fa-plus"></i> Add Person
                    </a>
                    <a asp-action="@nameof(PersonsController.Index)" asp-controller="Persons" class="btn btn-outline">
                        Clear filters
                    </a>
                </div>
            </div>
        </div>
    }
</form>

<style>.sv-hidden { display: none !important; }</style>

<script>
(function () {
    'use strict';

    var searchBy   = document.getElementById('searchBy');
    var txtCtrl    = document.getElementById('searchValueText');
    var genderCtrl = document.getElementById('searchValueGender');
    var dateCtrl   = document.getElementById('searchValueDate');
    var hidden     = document.getElementById('searchValueHidden');

    function getActive() {
        var v = searchBy.value;
        if (v === 'Gender')        return genderCtrl;
        if (v === 'DateOfBirth')   return dateCtrl;
        return txtCtrl;
    }

    function syncHidden() {
        hidden.value = getActive().value;
    }

    function showActive() {
        [txtCtrl, genderCtrl, dateCtrl].forEach(function (el) { el.classList.add('sv-hidden'); });
        getActive().classList.remove('sv-hidden');
    }

    txtCtrl.addEventListener('input',     syncHidden);
    genderCtrl.addEventListener('change', syncHidden);
    dateCtrl.addEventListener('change',   syncHidden);


    searchBy.addEventListener('change', function () {
        txtCtrl.value    = '';
        genderCtrl.value = '';
        dateCtrl.value   = '';
        hidden.value     = '';
        showActive();
        getActive().focus();
    });

    // On page load, prime the hidden field from whichever control is already visible
    syncHidden();
})();
</script>