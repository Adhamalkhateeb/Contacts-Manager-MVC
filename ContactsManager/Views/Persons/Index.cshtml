@model PersonsListViewModel
@{
    ViewBag.Title = "Persons";
}
@{
    string BuildOrderLink(string orderBy)
    {
        return
@$"/persons/index?searchBy={Model.SearchBy}&searchValue={Model.SearchValue}&orderBy={orderBy}&sortOrder={(Model.SortOrder
== "ASC" ? "DESC" : "ASC")}";
    }

    string SelectSortArrow(string columnName)
    {
        if (Model.OrderBy == columnName)
        {
            if (Model.SortOrder == "ASC")
                return " <i class='fa-solid fa-sort-down'></i>";
            else
                return " <i class='fa-solid fa-sort-up '></i>";
        }

        return "";
    }
}

<form asp-controller="Persons" asp-action="@nameof(PersonsController.Index)" method="get">
    <h1>Persons</h1>
    <a asp-controller="Persons" asp-action="@nameof(PersonsController.Create)">Create Person</a>
    <a asp-controller="Persons" asp-action="@nameof(PersonsController.PersonsPDF)" class="ml">Download as PDF</a>
    <a asp-controller="Persons" asp-action="@nameof(PersonsController.DownloadPersonsCsv)" class="ml">Download as
        CSV</a>
        <a asp-controller="Persons" asp-action="@nameof(PersonsController.DownloadPersonsExcel)" class="ml">Download as
            Excel</a>


            <div class="box flex">
                <div class="flex-1">
                    <select class="form-input" name="searchBy">
                        @foreach (var field in Model.SearchFields)
                        {
                            <option selected="@(Model.SearchBy == field.Key)" value="@field.Key">@field.Value</option>
                        }
                    </select>
                </div>
                <div class="flex-1">
                    <input type="search" id="search" class="form-input" placeholder="Search" name="searchValue"
                           value="@Model.SearchValue">
                </div>
                <div class="flex-1">
                    <button class="button button-blue-back">Search</button>
                    <a asp-action="@nameof(PersonsController.Index)" asp-controller="Persons" class="link-hover">Clear All</a>
                </div>

            </div>

            <table class="table w-100 mt">
                <thead>
                    <tr>
                        <th>
                            <a href="@BuildOrderLink(nameof(PersonResponse.Name))"> Name</a>
                            @Html.Raw(SelectSortArrow(nameof(PersonResponse.Name)))
                        </th>
                        <th>
                            <a href="@BuildOrderLink(nameof(PersonResponse.Email))"> Email</a>
                            @Html.Raw(SelectSortArrow(nameof(PersonResponse.Email)))
                        </th>
                        <th>
                            <a href="@BuildOrderLink(nameof(PersonResponse.DateOfBirth))"> Date Of Birth </a>
                            @Html.Raw(SelectSortArrow(nameof(PersonResponse.DateOfBirth)))
                        </th>
                        <th>
                            <a href="@BuildOrderLink(nameof(PersonResponse.Age))"> Age </a>
                            @Html.Raw(SelectSortArrow(nameof(PersonResponse.Age)))
                        </th>
                        <th>
                            <a href="@BuildOrderLink(nameof(PersonResponse.Gender))"> Gender </a>
                            @Html.Raw(SelectSortArrow(nameof(PersonResponse.Gender)))
                        </th>
                        <th>
                            <a href="@BuildOrderLink(nameof(PersonResponse.Country))"> Country </a>
                            @Html.Raw(SelectSortArrow(nameof(PersonResponse.Country)))
                        </th>
                        <th>
                            <a href="@BuildOrderLink(nameof(PersonResponse.Address))"> Address </a>
                            @Html.Raw(SelectSortArrow(nameof(PersonResponse.Address)))
                        </th>
                        <th>
                            <a href="@BuildOrderLink(nameof(PersonResponse.ReceiveNewsLetters))"> Receives News Letter </a>
                            @Html.Raw(SelectSortArrow(nameof(PersonResponse.ReceiveNewsLetters)))
                        </th>
                        <th>
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var person in Model.Persons)
                    {
                        <tr>
                            <td style="width: 10%;">@person.Name</td>
                            <td style="width: 20%;">@person.Email</td>
                            <td style="width: 10%;">@person.DateOfBirth.GetValueOrDefault().ToString("dd MMM yyyy")</td>
                            <td style="width: 10%;">@person.Age</td>
                            <td style="width: 10%;">@person.Gender</td>
                            <td style="width: 10%;">@person.Country</td>
                            <td style="width: 15%;">@person.Address</td>
                            <td style="width: 15%;">@person.ReceiveNewsLetters</td>
                            <td style="width: 20%;">
                                <a class="text-grey" asp-controller="Persons" asp-action="Edit" asp-route-id="@person.Id">Edit</a>
                                <a class="text-red" asp-controller="Persons" asp-action="Delete"
                                   asp-route-id="@person.Id">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </form>